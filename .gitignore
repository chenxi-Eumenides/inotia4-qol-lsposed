# ============================================================
# 环境隔离：本仓库只跟踪「项目内」文件。
# 所有可再生成的中间产物、缓存、构建输出一律忽略，
# ============================================================

# ---- Python（项目内 venv 与缓存）----
.venv/
__pycache__/
*.py[cod]

# ---- Gradle 缓存与构建产物（缓存已指向项目内 .gradle/）----
.gradle/
**/build/
**/build-local/
**/build-qol/
**/.cxx/
.kotlin/
local.properties

# ---- 二进制输入及中间产物 ----
apk/
archive/

# ---- 静态库（apk/static-data/ 由原始 APK 解析生成，可再生成；APK 内嵌子集同）----
module/app/src/main/assets/static-data/

# ---- 工具（本机安装，不入库：NDK 2GB / lspatch 等）----
tools/

# 历史实验脚本默认不入库；正式入口脚本按下方规则精确放行。
scripts/*
!scripts/AGENTS.md
!scripts/build-debug.sh
!scripts/build-release.sh
!scripts/analysis/
!scripts/analysis/frida/
!scripts/analysis/frida/save0-repair-patch.js
!scripts/verification/
!scripts/verification/smoke_all.py
!scripts/verification/smoke_baseline_v0.5.43.json
!scripts/verification/live_session.py
!scripts/verification/api_poll.py
!scripts/device/
!scripts/device/touch_automation.py
!scripts/maintenance/
!scripts/maintenance/check_symbols.py
!scripts/data/
!scripts/data/**
scripts/data/**/__pycache__/
scripts/data/**/*.py[cod]

# ---- 构建产物 APK（可重新构建）----
output/

# ---- 测试日志 / 采样数据 ----
log/

# ---- 临时文件 ----
.tmp/

# ---- 编辑器/系统杂项 ----
.DS_Store
*.swp
.sisyphus

# ---- 其他文件 ----
docs/history/experiments/改版作者的一些探索文档
