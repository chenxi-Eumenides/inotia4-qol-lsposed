# ============================================================
# 环境隔离：本仓库只跟踪「项目内」文件。
# 所有可再生成的中间产物、缓存、构建输出一律忽略，
# ============================================================

# ---- Python（项目内 venv 与缓存）----
.venv/
__pycache__/
*.py[cod]

# ---- Gradle 缓存与构建产物（缓存已指向项目内 .gradle/）----
.gradle/
**/build/
**/.cxx/
.kotlin/
local.properties

# ---- 二进制输入及中间产物 ----
apk/
archive/

# ---- 静态库（apk/static-data/ 由原始 APK 解析生成，可再生成；APK 内嵌子集同）----
module/app/src/main/assets/static-data/

# ---- 工具（本机安装，不入库：NDK 2GB / lspatch 等）----
tools/
scripts/

# ---- 构建产物 APK（可重新构建）----
output/

# ---- 测试日志 / 采样数据 ----
log/

# ---- 临时文件 ----
.tmp/

# ---- 编辑器/系统杂项 ----
.DS_Store
*.swp

# ---- 其他文件 ----
.sisyphus
docs/改版作者的一些探索文档
**/build-local/
